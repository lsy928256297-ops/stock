# 复制为 .env 后修改
# cp .env.example .env

# ===== LLM 配置（必填）=====
AI_HR_API_KEY=sk-xxxxxxxxxxxxxxxxx
AI_HR_API_BASE=https://api.openai.com/v1
AI_HR_MODEL=gpt-4o-mini

# ===== 安全 =====
# 随机 64 字节 hex，命令生成：openssl rand -hex 32
AI_HR_SECRET_KEY=please-change-me-to-a-random-string

# ===== 邀请码（首次启动入库）=====
AI_HR_INVITE_CODES=INVITE-001,INVITE-002

# ===== 管理员账户 =====
# 这里填的用户名，注册后即自动拥有邀请码管理权限
AI_HR_ADMIN_USERS=admin

# 关闭注册（只留内部使用）
# AI_HR_DISABLE_SIGNUP=1

# 生产（带 HTTPS 反代）时启用
# AI_HR_COOKIE_SECURE=1

# LLM 超时（秒）；Claude Opus 等慢模型建议 1200
AI_HR_TIMEOUT=600

# 服务监听端口（docker-compose 模式下外部映射端口）
AI_HR_PORT=8765
